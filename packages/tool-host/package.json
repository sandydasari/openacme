{
  "name": "@openacme/tool-host",
  "version": "0.7.0",
  "description": "Per-agent sandboxed tool execution for OpenAcme \u2014 raw tools (filesystem, shell, exec) run in an OS-confined worker process; the daemon stays clean of policy logic.",
  "license": "MIT",
  "author": "sandydasari",
  "homepage": "https://github.com/sandydasari/openacme/tree/main/packages/tool-host#readme",
  "bugs": "https://github.com/sandydasari/openacme/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandydasari/openacme.git",
    "directory": "packages/tool-host"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.54",
    "@openacme/config": "workspace:*",
    "@openacme/mcp-client": "workspace:*",
    "@openacme/tools": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "5.9.2",
    "vitest": "^2.1.9"
  }
}
