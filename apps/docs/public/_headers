# Cloudflare Pages caching
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/screens/*
  Cache-Control: public, max-age=604800

/media/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=86400

/api/search
  Cache-Control: public, max-age=3600

# Install script — short TTL so fixes roll out fast; serve as plain text so
# `curl | sh` doesn't get an HTML error page if the path is ever wrong.
/install.sh
  Content-Type: text/x-shellscript; charset=utf-8
  Cache-Control: public, max-age=3600

# LLM-facing text surfaces — short TTL so content edits roll out fast.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/md/*
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
